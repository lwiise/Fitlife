# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Monorepo
.turbo/
**/.turbo/
**/node_modules/
**/.next/
**/dist/
**/.env.local
**/coverage/

# Supabase CLI workspace (auto-created at repo root by `npx supabase ...`)
# Our migrations live in apps/app/supabase/ which stays tracked.
/supabase/

# Claude Code worktrees — local working copies with their own .git, never the repo's.
# If committed they become submodule gitlinks with no .gitmodules url and break the
# Netlify build's submodule checkout.
.claude/worktrees/

# E2E suite local config + artifacts
apps/e2e/.env.e2e
apps/e2e/reports/
apps/e2e/.e2e-state/
# Local design references (cloned repos browsed for layout ideas, never imported).
# Same gitlink hazard as worktrees if committed.
_reference/

# Generated Lottie QA sheets (rebuild with apps/landing/scripts/deal-seal-lottie/qa.mjs).
apps/*/scripts/**/qa-out/
apps/*/qa-out/
