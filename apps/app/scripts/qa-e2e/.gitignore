# Run output: contains a real test account's email, user id and plaintext
# password. Never commit it.
results.json

# Same rule, matrix runner: the ledger is a list of LIVE production accounts
# with their password, and the results carry emails plus plan_data.
matrix-accounts.json
matrix-accounts.jsonl
matrix-results*.json
cleanup-report.json

# Diagnostic dumps of a real account's plan_data.
plan-dump.json
probe-dump.json

# Screenshots of a real signed-in session (and of a hosted checkout page) —
# they show personal data and account state.
shots/
*.png

# Runner logs. They carry account emails once the verify phase writes its
# summary, and they are pure run artifacts either way.
*.log
